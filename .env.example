# --- Core (required) ---
SIBYL_MEMORY_DB=data/sibyl_memory.db
SIBYL_TENANT_ID=00000000-0000-0000-0000-000000000001
BASE_PRIVATE_KEY=
BASE_RPC_URL=https://sepolia.base.org

# On-chain attestation is an explicit, opt-in step (run: python continuum.py attest <id>).
# session2 / session3 / check-deadlines only detect and record breaches; they never broadcast.

# --- Optional: Virtuals ACP (off the core path; not required) ---
# Continuum is fully functional without these. Set them only once real ACP
# credentials exist and the VirtualsCoordinator seam has been wired in.
# VIRTUALS_ACP_URL=
# VIRTUALS_API_KEY=
